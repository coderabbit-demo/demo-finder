# GitHub PAT with repo scope (crawl + fork + open PRs)
GITHUB_TOKEN=
# Anthropic key for LLM scoring / NL search / config generation (optional — heuristics fallback without it)
ANTHROPIC_API_KEY=
# true = seed sample repos/PRs/scores so the UI has data with no tokens
DEV_MODE=true
# Defaults to sqlite+aiosqlite:///./demo.db when unset (no docker needed)
DATABASE_URL=
